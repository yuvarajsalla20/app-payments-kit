{
  "name": "app-payments-kit",
  "version": "2.11.0",
  "description": "Reusable payments for React Native / Expo apps: one API over the App Store, Google Play (RevenueCat mobile) and the website (RevenueCat web), any number of tiers and plans, a webhook and subscription row for any backend (ready for Supabase and Firebase), and a developer-only tester switch.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "revenuecat-mobile.ts",
    "revenuecat-web.ts",
    "supabase.ts",
    "firestore.ts",
    "server.mjs",
    "server",
    "firebase-function.mjs",
    "firestore",
    "supabase/sql",
    "supabase/functions",
    "docs"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Yuvaraj Salla",
  "peerDependencies": {
    "@revenuecat/purchases-js": ">=1.0",
    "@supabase/supabase-js": ">=2.39",
    "firebase": ">=11",
    "firebase-admin": ">=12",
    "firebase-functions": ">=6",
    "react-native": ">=0.74",
    "react-native-purchases": ">=8"
  },
  "peerDependenciesMeta": {
    "@revenuecat/purchases-js": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "firebase": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "firebase-functions": {
      "optional": true
    },
    "react-native-purchases": {
      "optional": true
    }
  },
  "devDependencies": {
    "@revenuecat/purchases-js": "^1.74.0",
    "@supabase/supabase-js": "^2.119.0",
    "firebase": "^11.10.0",
    "react-native-purchases": "^10.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p ."
  }
}
