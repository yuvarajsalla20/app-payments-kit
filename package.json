  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "revenuecat.ts",
    "supabase.ts",
    "supabase/sql",
    "supabase/functions",
    "docs"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Yuvaraj Salla",
  "peerDependencies": {
    "@supabase/supabase-js": ">=2.39",
    "react-native": ">=0.74",
    "react-native-purchases": ">=8"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": { "optional": true },
    "react-native-purchases": { "optional": true }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react-native-purchases": "^10.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p ."
  }
}
