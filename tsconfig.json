{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [],
    "paths": {
      "react-native": [
        "./tests/stubs/react-native.ts"
      ]
    },
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src",
    "revenuecat-mobile.ts",
    "revenuecat-web.ts",
    "supabase.ts",
    "firestore.ts",
    "server.mjs",
    "server",
    "typetests"
  ]
}
